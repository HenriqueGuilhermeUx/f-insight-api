PORT=3000
NODE_ENV=production

# Supabase legado/opcional
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-key

# Persistencia dedicada do F-Insight (preferida)
FINSIGHT_DATA_SUPABASE_URL=https://your-project.supabase.co
FINSIGHT_DATA_SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_backend_secret

# APIs externas
FINNHUB_API_KEY=your-finnhub-api-key
COINGECKO_API_KEY=your-coingecko-api-key

# CORS - URLs permitidas (separadas por virgula)
ALLOWED_ORIGINS=https://f-insight.org,https://www.f-insight.org,https://*.netlify.app,http://localhost:5173
